# Copy to .env and fill in. Never commit real secrets.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# Single Postgres connection string (dj_database_url). Replace the
# password with your real one.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/book

# Only needed when running the real Celery worker / beat locally.
REDIS_URL=redis://localhost:6379/0

PAYSTACK_SECRET_KEY=sk_test_xxx
